\begin_layout Standard
Current model
\end_layout

\begin_layout Standard
\begin_inset Formula $\mathbf{v}_{t}=\mathbf{p}\odot\mathbf{v}_{t-1}+(1-\mathbf{p})\odot(D_{in}SD_{out}f(\mathbf{v}_{t-1})+\mathbf{b}+\mathbf{c}\odot\mathbf{u}_{t})$
\end_inset


\end_layout

\begin_layout Standard
Conductance model
\end_layout

\begin_layout Standard
\begin_inset Formula $V\equiv V_{inside}-V_{outside}$
\end_inset


\end_layout

\begin_layout Standard
inward flow of positive charge as defined as positive current
\end_layout

\begin_layout Standard
Capacitance current 
\begin_inset Formula $I_{C}=C_{m}\frac{dV}{dt}$
\end_inset


\end_layout

\begin_layout Standard
Cation channel current 
\begin_inset Formula $I_{exc}=g(V-E)$
\end_inset


\end_layout

\begin_layout Standard
Where 
\begin_inset Formula $E$
\end_inset

 is the reversal potential and 
\begin_inset Formula $g$
\end_inset

 is the conductance
\end_layout

\begin_layout Standard
Kirchhoff's law (conservation of charge) where 
\begin_inset Formula $r$
\end_inset

 is a neurotransmitter
\end_layout

\begin_layout Standard
\begin_inset Formula $I_{C}+\sum_{r}I_{r}+I_{leak}+I_{inj}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $C_{m}\frac{dV}{dt}+\sum_{r}g_{r}(V-E_{r})+g_{leak}(V-E_{leak})+I_{inj}=0$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $\frac{d}{dt}V(t)=-C_{m}^{-1}\left[\sum_{r\in\{glu,ach,gaba\}}(V(t)-E_{r})\odot g_{r}(t)+(V(t)-E_{leak})\odot g_{leak}+I_{inj}\right]$
\end_inset


\end_layout

\begin_layout Standard
Discrete Conductance.
 Define 
\begin_inset Formula $I_{inj}\equiv-b\odot u_{t}$
\end_inset

 i.e.
 positive inputs cause depolarization
\end_layout

\begin_layout Standard
\begin_inset Formula $v_{t+1}=v_{t}-\Delta tC_{m}^{-1}\left[\sum_{r\in\{glu,ach,gaba\}}(v_{t}-E_{r})\odot g_{r}(v_{t})+(v_{t}-E_{leak})\odot g_{leak}-b\odot\mathbf{u}_{t}\right]$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $g_{r}(t)=D_{in,r}S_{r}D_{out,r}f(V(t)-\theta)$
\end_inset


\end_layout

\begin_layout Standard
The conductance for a given neurotransmitter is governed by the strength of the presynaptic neuron 
\begin_inset Formula $D_{out,r}$
\end_inset

 the strength of the postsynaptic connection 
\begin_inset Formula $D_{in,r}$
\end_inset

 the number of synapses 
\begin_inset Formula $S_{i,r}$
\end_inset

 and the firing rate of the presynaptic neuron 
\begin_inset Formula $f(V(t)-\theta)$
\end_inset

 where 
\begin_inset Formula $f$
\end_inset

 is a softplus
\end_layout

