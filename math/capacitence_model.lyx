\begin_layout Standard
Current model
\end_layout

\begin_layout Standard
\begin_inset Formula $\mathbf{v}_{t}=\mathbf{p}\odot\mathbf{v}_{t-1}+(1-\mathbf{p})\odot(D_{in}SD_{out}f(\mathbf{v}_{t-1})+\mathbf{b}+\mathbf{c}\odot\mathbf{u}_{t})$
\end_inset


\end_layout

\begin_layout Standard
Conductance model
\end_layout

\begin_layout Standard
\begin_inset Formula $-C_{m}\frac{d}{dt}V(t)=\sum_{r}^{glu,acytl,gaba}(V(t)-E_{r})g_{r}(t)+(V(t)-E_{leak})g_{leak}+u_{in}\odot\mathbf{u}_{t}$
\end_inset


\end_layout

\begin_layout Standard
Conductance model says that all the current flow is the sum of
\end_layout

\begin_layout Standard
capacitive current 
\begin_inset Formula $C_{m}\frac{d}{dt}V(t)$
\end_inset


\end_layout

\begin_layout Standard
Synaptic input 
\begin_inset Formula $\sum_{r}^{glu,acytl,gaba}(V(t)-E_{r})g_{r}(t)$
\end_inset


\end_layout

\begin_layout Standard
Where the driving force of that current (i forget this terminology) is 
\begin_inset Formula $V(t)-E_{r}$
\end_inset

 and 
\begin_inset Formula $E_{r}$
\end_inset

 is the reversal potential and 
\begin_inset Formula $g_{r}(t)$
\end_inset

 is the conductance
\end_layout

\begin_layout Standard
The leak current 
\begin_inset Formula $(V(t)-E_{leak})g_{leak}$
\end_inset


\end_layout

\begin_layout Standard
And direct current injection 
\begin_inset Formula $\mathbf{c}\odot\mathbf{u}_{t}$
\end_inset


\end_layout

\begin_layout Standard
The conductance for a given neurotransmitter is governed by the strength of the presynaptic neuron 
\begin_inset Formula $D_{out,r}$
\end_inset

 the strength of the postsynaptic connection 
\begin_inset Formula $D_{in,r}$
\end_inset

 the number of synapses 
\begin_inset Formula $S_{i,r}$
\end_inset

 and the firing rate of the presynaptic neuron 
\begin_inset Formula $f(V(t)-b)$
\end_inset

 where 
\begin_inset Formula $f$
\end_inset

 is a ReLU
\end_layout

\begin_layout Standard
\begin_inset Formula $g_{r}(t)=D_{in,r}S_{r}D_{out,r}f(V(t)-b)$
\end_inset


\end_layout

\begin_layout Standard
Relationship between the two models
\end_layout

\begin_layout Standard
\begin_inset Formula $(V(t)-E_{r})g_{r}(t)=V(t)D_{in,r}S_{r}D_{out,r}f(V(t)-b)-E_{r}D_{in,r}S_{r}D_{out,r}f(V(t)-b)$
\end_inset


\end_layout

